# Paths are relative to LAB_ROOT unless explicitly documented otherwise.

LAB_COMPONENTS_DIR=components
LAB_PROJECTS_DIR=projects
LAB_WORKSPACES_DIR=workspaces
LAB_STATE_DIR=state
LAB_EVIDENCE_DIR=evidence
LAB_LOG_DIR=logs
LAB_SECRETS_DIR=secrets
