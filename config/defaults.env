# Paths are relative to LAB_ROOT unless explicitly documented otherwise.

LAB_COMPONENTS_DIR=components
LAB_PROJECTS_DIR=projects
LAB_WORKSPACES_DIR=workspaces
LAB_STATE_DIR=state
LAB_EVIDENCE_DIR=evidence
LAB_LOG_DIR=logs
LAB_SECRETS_DIR=secrets
LAB_TMP_DIR=tmp
LAB_RUNTIME_DIR=runtime

# Agent Lab owns managed runtime material.
LAB_RUNTIME_BIN_DIR=runtime/bin
LAB_RUNTIME_PYTHON_DIR=runtime/python
LAB_RUNTIME_UV_TOOLS_DIR=runtime/uv-tools
LAB_RUNTIME_UV_TOOL_BIN_DIR=runtime/uv-tool-bin
LAB_RUNTIME_CACHE_DIR=runtime/cache

# Host ports are intentionally not fixed.
LAB_GPU_ENABLED=false
